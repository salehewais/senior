# Base URL for /api/v1. No database URL and no secrets belong in the client.
# Direct order service, including tests and curl that talk to the API itself:
#   VITE_API_BASE_URL=http://127.0.0.1:8000
# Documented browser path while Traefik is running (Phase 10):
#   VITE_API_BASE_URL=http://127.0.0.1:8080
# The default below stays 8000 so a storefront checkout still reaches the API
# when the gateway is not started. client.ts uses the same default.
VITE_API_BASE_URL=http://127.0.0.1:8000
