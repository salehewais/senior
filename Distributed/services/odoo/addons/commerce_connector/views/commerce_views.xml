<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commerce_inventory_state_list" model="ir.ui.view">
        <field name="name">commerce.inventory.state.list</field>
        <field name="model">commerce.inventory.state</field>
        <field name="arch" type="xml">
            <list>
                <field name="sku"/>
                <field name="commerce_product_id"/>
                <field name="on_hand"/>
                <field name="reserved"/>
                <field name="warehouse_code"/>
                <field name="version"/>
            </list>
        </field>
    </record>

    <record id="view_commerce_processed_event_list" model="ir.ui.view">
        <field name="name">commerce.processed.event.list</field>
        <field name="model">commerce.processed.event</field>
        <field name="arch" type="xml">
            <list>
                <field name="processed_at"/>
                <field name="event_id"/>
                <field name="event_type"/>
                <field name="aggregate_id"/>
                <field name="consumer_name"/>
            </list>
        </field>
    </record>

    <record id="action_commerce_inventory_state" model="ir.actions.act_window">
        <field name="name">Stock snapshots</field>
        <field name="res_model">commerce.inventory.state</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_commerce_processed_event" model="ir.actions.act_window">
        <field name="name">Processed events</field>
        <field name="res_model">commerce.processed.event</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_commerce_root" name="Commerce" parent="sale.sale_menu_root" sequence="80"/>
    <menuitem id="menu_commerce_inventory" name="Stock snapshots" parent="menu_commerce_root"
              action="action_commerce_inventory_state" sequence="10"/>
    <menuitem id="menu_commerce_processed" name="Processed events" parent="menu_commerce_root"
              action="action_commerce_processed_event" sequence="20"/>
</odoo>
