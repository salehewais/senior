# Local placeholders. These are for the laptop containers only.
# Do not copy them into a shared environment.

# Odoo UI and XML-RPC. The database user admin is created by Odoo's base data
# with this password. odoo.conf admin_passwd is the database manager password,
# also the local placeholder admin.
ODOO_URL=http://127.0.0.1:8069
ODOO_DB=odoo_db
ODOO_USER=admin
ODOO_PASSWORD=admin
ODOO_TIMEOUT_SECONDS=5

# The inventory publisher opens this database. It refuses order_db and reporting_db.
# Host port 5434 is services/odoo/compose.yaml. User and password match that file.
ODOO_DATABASE_URL=postgresql://odoo:odoo@127.0.0.1:5434/odoo_db
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=10000

# Same broker as services/order-service/compose.yaml.
RABBITMQ_URL=amqp://order_service:order_service@127.0.0.1:5672/%2F
RABBITMQ_TIMEOUT_SECONDS=5

# Fulfillment buttons inside the Odoo container call the order service on the host.
# Set INTERNAL_SERVICE_TOKEN to the same value as the order service. Leave it empty
# in git. An empty token makes the button stop before any HTTP call.
ORDER_SERVICE_URL=http://host.docker.internal:8000
ORDER_SERVICE_TIMEOUT_SECONDS=5
INTERNAL_SERVICE_TOKEN=

OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=5
