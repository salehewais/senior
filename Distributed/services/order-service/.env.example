# Local placeholder. This password is for the laptop Postgres container only.
# Do not copy it into a shared environment.
DATABASE_URL=postgresql+psycopg://order_service:order_service@localhost:5432/order_db

# RS256 key pair. Paste PEM text, or point at files generated outside git.
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt_private.pem && openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# Local placeholder. This user and password are for the laptop RabbitMQ container only.
# Do not copy them into a shared environment. AMQP is bound to 127.0.0.1:5672.
RABBITMQ_URL=amqp://order_service:order_service@127.0.0.1:5672/%2F
# Connect, declare, and publisher confirm all stop after this many seconds.
RABBITMQ_TIMEOUT_SECONDS=5

# Shared header for internal fulfillment routes. Empty means those routes return 503.
# Learning simplification: production would use a private network plus a rotated credential or mTLS.
INTERNAL_SERVICE_TOKEN=

# Optional staff seed: python -m order_service.infrastructure.seed_staff
# An account is created only when both variables for that role are set and the email is new.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=
