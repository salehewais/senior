# Local placeholders. Not credentials for a shared environment.
# This URL is reporting_db on port 5433. Do not point it at order_db or odoo_db.
REPORTING_DATABASE_URL=postgresql://reporting_service:reporting_service@127.0.0.1:5433/reporting_db

# Same broker as services/order-service/compose.yaml. Local placeholder password.
RABBITMQ_URL=amqp://order_service:order_service@127.0.0.1:5672/%2F
RABBITMQ_TIMEOUT_SECONDS=5

# Connect and statement timeouts for reporting_db. There is no order_db DSN.
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=10000

# Public key only. The private key stays with the order service.
# JWT_PUBLIC_KEY_PEM=
JWT_PUBLIC_KEY_PATH=

DJANGO_SECRET_KEY=local-reporting-dev-only
