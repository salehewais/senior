{
  "uid": "order-path",
  "title": "Order path",
  "description": "FastAPI: requests per second, p50, p95, p99, errors, and orders. Business counters for created, confirmed, cancelled, shipped, and delivered are on this board.",
  "tags": [
    "commerce",
    "phase-12"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(http_requests_total{service=\"order-service\"}[1m]))",
          "refId": "A",
          "legendFormat": "{{route}}"
        }
      ]
    },
