{
  "uid": "outbox-and-broker",
  "title": "Outbox and broker",
  "description": "RabbitMQ publish rate, consume rate, queue depth, unacked, consumers, retries, and DLQ. Outbox pending, published, failed, and publish latency.",
  "tags": [
    "commerce",
    "phase-12"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Publish rate",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(rabbitmq_global_messages_received_total[1m]))",
          "refId": "A",
          "legendFormat": "published"
        }
      ]
    },
