# Copy to deploy/compose/.env. That file is gitignored. Do not commit it.
# Database, RabbitMQ, Redis, and Odoo passwords are local placeholders in
# docker-compose.yml. They are not credentials for a shared environment.
#
# Generate the JWT PEMs on the host. See README "How to run the full stack".
# Defaults, relative to this directory:
#   ./secrets/jwt_private.pem  mounted only into the order service
#   ./secrets/jwt_public.pem   mounted into the gateway JWT check and reporting
# JWT_PRIVATE_KEY_PATH=
# JWT_PUBLIC_KEY_PATH=

# Shared by the order service and the Odoo connector. Not passed to the frontend.
# Empty means the fulfillment routes return 503 and the Odoo buttons make no HTTP call.
INTERNAL_SERVICE_TOKEN=
