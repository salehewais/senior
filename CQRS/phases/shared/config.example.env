# Copy to config.env and fill in. Do not commit secrets.

# Odoo primary (writes / POS) — Phase 0 measurement only for reports; avoid report SQL here after Phase 1
PRIMARY_DSN=postgresql://odoo:SECRET@primary-host:5432/odoo

# Streaming replica — Exact reports + Phase 2 aggregation source/target
REPLICA_DSN=postgresql://odoo_reporting:SECRET@replica-host:5432/odoo

# Phase 3+ dedicated analytical store
REPORTING_DSN=postgresql://reporting_writer:SECRET@reporting-host:5432/reporting

# Optional warehouse (Phase 6)
WAREHOUSE_DSN=postgresql://wh_writer:SECRET@warehouse-host:5432/analytics

# Lag gate for Exact jobs (seconds)
EXACT_MAX_REPLICA_LAG_SECONDS=5

# Analytical freshness target (minutes) — documentation / monitors
ANALYTICAL_FRESHNESS_MINUTES=15

# Concurrency
REPORT_WORKER_CONCURRENCY=6
REPORT_STATEMENT_TIMEOUT_MS=180000

# Phase 2 refresh window (days rebuilt nightly)
AML_DAILY_WINDOW_DAYS=7
SALES_DAILY_WINDOW_DAYS=7

# Redis (Phase 1 queue / Phase 2 cache) — optional
REDIS_URL=redis://reporting-host:6379/0

# Artifact store for async PDF/Excel
ARTIFACT_DIR=/var/reporting/artifacts
