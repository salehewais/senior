<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_athir_external_mapping_list" model="ir.ui.view">
        <field name="name">athir.external.mapping.list</field>
        <field name="model">athir.external.mapping</field>
        <field name="arch" type="xml">
            <list>
                <field name="entity_type"/>
                <field name="external_id"/>
                <field name="external_name"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_athir_external_mapping_form" model="ir.ui.view">
        <field name="name">athir.external.mapping.form</field>
        <field name="model">athir.external.mapping</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="source_system"/>
                            <field name="entity_type"/>
                            <field name="external_id"/>
                            <field name="external_name"/>
                        </group>
                        <group>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_athir_external_mapping" model="ir.actions.act_window">
        <field name="name">External Mappings</field>
        <field name="res_model">athir.external.mapping</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
