<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_athir" model="ir.ui.view">
        <field name="name">res.partner.form.athir</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']" position="inside">
                <group string="Athir" name="athir_partner">
                    <field name="athir_mrn"/>
                    <field name="athir_insurance_company_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
