<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_athir_api_credential_list" model="ir.ui.view">
        <field name="name">athir.api.credential.list</field>
        <field name="model">athir.api.credential</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="has_token"/>
                <field name="revoked"/>
                <field name="last_used_at"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_athir_api_credential_form" model="ir.ui.view">
        <field name="name">athir.api.credential.form</field>
        <field name="model">athir.api.credential</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_token" type="object" string="Generate Token"
                            class="btn-primary"/>
                    <button name="action_revoke" type="object" string="Revoke"
                            invisible="revoked"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Revoked" bg_color="text-bg-danger"
                            invisible="not revoked"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="has_token"/>
                            <field name="revoked"/>
                            <field name="last_used_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Usage notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_athir_api_credential" model="ir.actions.act_window">
        <field name="name">API Credentials</field>
        <field name="res_model">athir.api.credential</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
