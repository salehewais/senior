<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_athir_processed_document_list" model="ir.ui.view">
        <field name="name">athir.processed.document.list</field>
        <field name="model">athir.processed.document</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="create_date"/>
                <field name="operation"/>
                <field name="external_id"/>
                <field name="status"/>
                <field name="odoo_move_id"/>
                <field name="company_id"/>
                <field name="error_code"/>
            </list>
        </field>
    </record>

    <record id="view_athir_processed_document_form" model="ir.ui.view">
        <field name="name">athir.processed.document.form</field>
        <field name="model">athir.processed.document</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="source_system"/>
                            <field name="operation"/>
                            <field name="external_id"/>
                            <field name="payload_hash"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="odoo_move_id"/>
                            <field name="company_id"/>
                            <field name="error_code"/>
                            <field name="error_message"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_athir_processed_document" model="ir.actions.act_window">
        <field name="name">Processed Documents</field>
        <field name="res_model">athir.processed.document</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
